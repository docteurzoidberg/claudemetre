# Modèle de prive.env : à copier sous ce nom, à la racine du dépôt, avec les valeurs du poste.
# prive.env reste en local (.gitignore). Les docs et les scripts y renvoient.
# Format shell : « . ./prive.env » les charge.

# Réseau local et Home Assistant
LAN=192.168.1.0/24
HA_URL=http://192.168.1.10:8123
HA_SAMBA='\\192.168.1.10\config'
HA_SAMBA_USER=homeassistant

# %TEMP% de Windows, vu depuis WSL
WIN_TEMP=/mnt/c/Users/moi/AppData/Local/Temp

# Le dépôt, vu depuis Windows
WSL_PROJET='\\wsl.localhost\Ubuntu-24.04\home\moi\dev\claudemetre'

# Blender (Windows), vu depuis WSL
BLENDER="/mnt/c/Program Files/Blender Foundation/Blender 5.2/blender.exe"

# Projet Fusion 360 qui contient le dossier claudometre/
FUSION_PROJET="Mon projet"
